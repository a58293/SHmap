          "profile": {
            "regionPosition": "海外 / 大荒区域，程州山地带【地图推定】(无史料支撑)",
            "oneLineSummary": "程州山是上古神话中承载鲧攻伐事迹的神秘山地，见于大荒经系的远古战争传说【地图推定】。",
            "briefSummary": "程州山是上古神话中承载鲧攻伐事迹的神秘山地，见于大荒经系的远古战争传说【地图推定】。",
            "basicSummary": "海外 / 大荒区域，程州山地带【地图推定】(无史料支撑)",
            "localTags": "大荒经域【原文直载】、程州山地【原文直载】、鲧攻伐事【原文直载】、上古遗迹【古注补充】、战争之地【地图推定】",
            "tileType": "山地【原文直载】",
            "hydrology": "原文未载明确【原文未载】",
