          "profile": {
            "regionPosition": "南海内部山地区域",
            "oneLineSummary": "位于南方海域内部的一座神秘山岳，与多座名山及帝王都城相邻，是南方地理架构的重要地标。",
            "briefSummary": "位于南方海域内部的一座神秘山岳，与多座名山及帝王都城相邻，是南方地理架构的重要地标。",
            "basicSummary": "南海内部山地区域",
            "localTags": "南海之内、海内名山、南方地标、四山拓扑、神圣山岳",
            "tileType": "山 / 海内岛山",
