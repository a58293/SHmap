          "profile": {
            "regionPosition": "海内东经水系源头区域",
            "oneLineSummary": "大江发源于汶山，作为岷三江的重要源头之一，向南流淌最终汇入长州南侧的大海。",
            "briefSummary": "大江发源于汶山，作为岷三江的重要源头之一，向南流淌最终汇入长州南侧的大海。",
            "basicSummary": "海内东经水系源头区域",
            "localTags": "大江、汶山、岷三江、水系源头、海内东经籍记载",
