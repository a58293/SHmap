          "profile": {
            "regionPosition": "西山经境内山岳区域",
            "oneLineSummary": "聂阳山是《山海经》记载的一处富含金玉与铁矿的山岳地块，承载着原始山岳独特的矿产地理风貌。",
            "briefSummary": "聂阳山是《山海经》记载的一处富含金玉与铁矿的山岳地块，承载着原始山岳独特的矿产地理风貌。",
            "basicSummary": "西山经境内山岳区域",
            "localTags": "山海经 · 西山经 · 金属矿产 · 玉石蕴藏 · 古代山岳 · 原典地理",
            "tileType": "山",
            "hydrology": "原文未载明确",
            "orientation": "西山经之相关山岳区域",
