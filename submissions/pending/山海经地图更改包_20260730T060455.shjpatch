        "dossier": {
          "format": "nine-section-v2",
          "parserVariant": "mixed-heading-punctuation-v2",
          "sourceFile": "朝阳.md",
          "profile": {
            "regionPosition": "淮水发源地余山西侧区域 [地图推定]",
            "oneLineSummary": "朝阳是位于淮水源头余山西侧的重要地理节点，与义乡相对，用于界定早期水系发源的具体方位。[地图推定]",
            "briefSummary": "朝阳是位于淮水源头余山西侧的重要地理节点，与义乡相对，用于界定早期水系发源的具体方位。[地图推定]",
            "basicSummary": "淮水发源地余山西侧区域 [地图推定]",
            "localTags": "方位坐标 / 淮水流域 / 余山以西 / 地理节点 / 水系界标 [地图推定]",
            "tileType": "原文未载明确 [原文未载]",
            "hydrology": "临近淮水发源地 [原文直载]",
            "orientation": "余山以西区域 [原文直载]",
            "sourceCitation": "《山海经·海内东经》 [原文直载]",
            "parentRegion": "海内东经 [原文直载]",
            "adjacentTiles": "余山（在朝阳东）、义乡（在余山东） [原文直载]",
            "relatedWaters": "淮水（发源于其东部） [原文直载]",
            "relatedLife": "原文未载明确 [原文未载]",
            "tileOriginalExcerpt": "“淮水出馀山，馀山在朝阳东，义乡西，入海，淮浦北。”出自《山海经·海内东经》。[原文直载]",
            "otherAllusions": "晋代郭璞注云：“今淮水出义阳平氏县桐柏山。”将其一带与现实中南阳平氏县的桐柏山相系，清代考据亦指“朝阳县今属新野”。[古注补充]",
            "detailedSummary": "朝阳地处《海内东经》所载区域，是界定淮水发源地的重要地理坐标 [原文直载]。根据原典记载，此处未记录具体的山水地貌、草木鸟兽或人群神祇 [原文未载]，纯粹作为水系的方位界标存在。它位于发源淮水的余山西侧，与余山东侧的义乡形成明确的空间参照关系 [原文直载]。尽管缺乏神异物产与神话遗迹 [原文未载]，但朝阳与余山、义乡共同构成了严密的淮水源头定位网。后世郭璞注将此处推至汉代义阳一带 [古注补充]。作为枢纽定位点，朝阳在早期水文地理考证中具有不可替代的地标价值 [地图推定]。",
            "geoEnvironment": "淮水发源地余山西侧区域 [地图推定]\n原文未载明确 [原文未载]\n临近淮水发源地 [原文直载]",
            "evidenceChain": "《山海经·海内东经》 [原文直载]\n晋代郭璞注云：“今淮水出义阳平氏县桐柏山。”将其一带与现实中南阳平氏县的桐柏山相系，清代考据亦指“朝阳县今属新野”。[古注补充]"
          },
