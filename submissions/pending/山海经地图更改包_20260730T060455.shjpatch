        "dossier": {
          "format": "nine-section-v2",
          "parserVariant": "mixed-heading-punctuation-v2",
          "sourceFile": "淮极.md",
          "profile": {
            "regionPosition": "海内东经淮水与汝水交汇区域【地图推定】",
            "oneLineSummary": "淮极是《海内东经》中汝水汇入淮水的重要交汇节点，地处期思之北，为海内东部水网走势的关键坐标。【地图推定】",
            "briefSummary": "淮极是《海内东经》中汝水汇入淮水的重要交汇节点，地处期思之北，为海内东部水网走势的关键坐标。【地图推定】",
            "basicSummary": "海内东经淮水与汝水交汇区域【地图推定】",
            "localTags": "汝水入淮【原文直载】、极西北【原文直载】、期思以北【原文直载】、水系交汇【地图推定】、方位参照【地图推定】",
            "tileType": "河流交汇处沿岸陆地 / 水网【地图推定】",
            "hydrology": "汝水在此汇入淮水【原文直载】",
            "orientation": "海内东部水系，期思之北区域【原文直载】",
            "sourceCitation": "《山海经·海内东经》【原文直载】",
            "parentRegion": "海内东经【原文直载】",
            "adjacentTiles": "天息山（汝水上游）【原文直载】、梁勉乡（天息山附近）【原文直载】、期思（在交汇处南侧）【原文直载】",
            "relatedWaters": "汝水【原文直载】、淮（即淮水）【原文直载】",
            "relatedLife": "原文未载【原文未载】",
            "tileOriginalExcerpt": "《海内东经》：“汝水出天息山，在梁勉乡西南，入淮极西北。一曰淮在期思北。”【原文直载】",
            "otherAllusions": "晋代郭璞注中常将“极”字释为“至”，即汝水“至”淮水之西北入淮，但历代也有视“淮极”为特定区域坐标的解读。后世水经学者多引此段考证汝水流向，以及春秋楚国古邑“期思”（今河南固始一带）的确切地理位置。【古注补充】",
            "detailedSummary": "淮极隶属于《山海经·海内东经》的水系地理版图，其核心属性是汝水与淮水两条主要水系汇合的水网节点【地图推定】。根据经文记载，汝水发源于梁勉乡西南的天息山，一路奔流，最终在“淮极西北”这一关键坐标点注入淮水【原文直载】。原典同时补充了“一曰淮在期思北”的线索，进一步确立了该交汇点与期思之间的南北相对位置【原文直载】。虽然原典未记载此处的特异草木鸟兽、矿物出产或人群神祇【原文未载】，但作为锚定汝、淮两水的关键坐标，它构成了海内东部大水系拓扑的重要一环。在梳理上古地理数据与沙盘演化时，此地块非常适合作为串联主干水网、承载水系流向的大型水文枢纽节点【地图推定】。",
            "geoEnvironment": "海内东经淮水与汝水交汇区域【地图推定】\n河流交汇处沿岸陆地 / 水网【地图推定】\n汝水在此汇入淮水【原文直载】",
            "evidenceChain": "《山海经·海内东经》【原文直载】\n晋代郭璞注中常将“极”字释为“至”，即汝水“至”淮水之西北入淮，但历代也有视“淮极”为特定区域坐标的解读。后世水经学者多引此段考证汝水流向，以及春秋楚国古邑“期思”（今河南固始一带）的确切地理位置。【古注补充】"
          },
