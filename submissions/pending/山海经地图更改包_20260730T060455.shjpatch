        "dossier": {
          "format": "nine-section-v2",
          "parserVariant": "mixed-heading-punctuation-v2",
          "sourceFile": "钟山1.md",
          "profile": {
            "regionPosition": "北海内外部交界区域 / 海外北方区域【地图推定】",
            "oneLineSummary": "钟山是北方极其核心的神圣山脉，由神明烛阴镇守，曾发生过神明鼓与钦䲹谋杀葆江并在此被天帝诛杀的著名事件。【地图推定】",
            "briefSummary": "钟山是北方极其核心的神圣山脉，由神明烛阴镇守，曾发生过神明鼓与钦䲹谋杀葆江并在此被天帝诛杀的著名事件。【地图推定】",
            "basicSummary": "北海内外部交界区域 / 海外北方区域【地图推定】",
            "localTags": "烛阴镇守【原文直载】、居钟山下【原文直载】、在无䏿东【原文直载】、神鼓之乡【原文直载】、瑶崖行刑【原文直载】、神明化鸟【原文直载】",
            "tileType": "山地 / 崖壁（瑶崖）【原文直载】",
            "hydrology": "未载明确【原文未载】",
            "orientation": "无䏿之国东侧 / 景山西北四百二十里【原文直载】",
            "sourceCitation": "《山海经·北山经》，《山海经·海外北经》【原文直载】",
            "parentRegion": "北次三经 / 海外北经【原文直载】",
            "adjacentTiles": "景山（在钟山东南）【原文直载】、瑶崖（在钟山东）【原文直载】、无䏿之国（在钟山西）【原文直载】",
            "relatedWaters": "未载明确【原文未载】",
            "relatedLife": "烛阴（神）【原文直载】、鼓（神）【原文直载】、钦䲹（神/怪）【原文直载】、大鹗（鸟）【原文直载】、鵔鸟（鸟）【原文直载】",
            "tileOriginalExcerpt": "《北山经》：“曰钟山，其子曰鼓...是与钦䲹杀葆江于昆仑之阳，帝乃戮之钟山之东曰瑶崖。”【原文直载】\n\n《海外北经》：“钟山之神，名曰烛阴...人面，蛇身，赤色，居钟山下。”【原文直载】",
            "otherAllusions": "晋代郭璞注《海外北经》“烛阴”时称：“即烛龙也，是照九阴之幽，因以为名焉。”明确将驻守钟山的烛阴与烛龙等同。【古注补充】",
            "detailedSummary": "钟山横跨北海内外，是北部图卷中极具压迫感的核心神话地标【地图推定】。人面蛇身、身长千里的创世级神祇烛阴（烛龙）便居于钟山下，其一呼一吸掌控着四季风云【原文直载】。此地更是著名的上古神明刑场：钟山之子神鼓与钦䲹，因在昆仑之阳谋杀葆江，最终双双被天帝诛杀于钟山东侧的瑶崖【原文直载】。二神死后戾气不散，神鼓化为引发大旱的鵔鸟，而钦䲹则化为招致兵灾的大鹗【原文直载】。尽管原典对钟山的草木水系未作过多着墨【原文未载】，但凭借烛阴的镇守以及鼓与钦䲹所留下的神罚遗迹，这里无疑是上古地理空间中极为重要且震撼的坐标节点【地图推定】。",
            "geoEnvironment": "北海内外部交界区域 / 海外北方区域【地图推定】\n山地 / 崖壁（瑶崖）【原文直载】\n未载明确【原文未载】",
            "evidenceChain": "《山海经·北山经》，《山海经·海外北经》【原文直载】\n晋代郭璞注《海外北经》“烛阴”时称：“即烛龙也，是照九阴之幽，因以为名焉。”明确将驻守钟山的烛阴与烛龙等同。【古注补充】"
          },
