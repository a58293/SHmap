        "dossier": {
          "format": "nine-section-v2",
          "parserVariant": "mixed-heading-punctuation-v2",
          "sourceFile": "巴遂山.md",
          "profile": {
            "regionPosition": "海内西南区域，流黄辛氏国/流黄酆氏国境内【地图推定】",
            "oneLineSummary": "巴遂山位于海内方国境内，是渑水的水源发源地，其所在区域以出产尘土为特征。【地图推定】",
            "briefSummary": "巴遂山位于海内方国境内，是渑水的水源发源地，其所在区域以出产尘土为特征。【地图推定】",
            "basicSummary": "海内西南区域，流黄辛氏国/流黄酆氏国境内【地图推定】",
            "localTags": "流黄辛氏【原文直载】、流黄酆氏【原文直载】、渑水之源【原文直载】、有涂四方【原文直载】、出产尘土【原文直载】、后稷葬西【原文直载】",
            "tileType": "山地【原文直载】",
            "hydrology": "渑水发源地【原文直载】",
            "orientation": "海内西南陬以北区域，方圆三百里国度之中【原文直载】",
            "sourceCitation": "《山海经·海内经》，《山海经·海内西经》【原文直载】",
            "parentRegion": "海内【原文直载】",
            "adjacentTiles": "流黄辛氏国 / 流黄酆氏国【原文直载】、后稷之葬（在巴遂山东）【原文直载】、朱卷之国【地图推定】",
            "relatedWaters": "渑水【原文直载】",
            "relatedLife": "未载【原文未载】",
            "tileOriginalExcerpt": "《海内经》：“有国名曰流黄辛氏，其域中方三百里，其出是尘土。有巴遂山，渑水出焉。”【原文直载】\n\n《海内西经》：“流黄酆氏之国，中方三百里。有涂四方，中有山。在后稷葬西。”【原文直载】",
            "otherAllusions": "历代古注多认为《海内经》之“流黄辛氏”即《海内西经》之“流黄酆氏国”，“中有山”即明确指代巴遂山。两者实为同一地块在不同篇目中的记述。【古注补充】",
            "detailedSummary": "巴遂山地处海内西南区域，坐落于流黄辛氏国（又作流黄酆氏国）境内【地图推定】。该地块的核心属性为内陆山地，同时也是渑水的发源地【原文直载】。围绕巴遂山的方国面积达“中方三百里”，交通便利“有涂四方”，并以特产尘土为主要物产【原文直载】。从地理方位看，巴遂山在后稷之葬的西侧，附近可能与朱卷之国接壤【原文直载/地图推定】。尽管《山海经》原典中未载明此地的草木鸟兽与神祇遗迹【原文未载】，但作为方国中央的地理坐标，巴遂山在海内水系与部族聚落的分布中占有确切的一席之地【古注补充】。",
            "geoEnvironment": "海内西南区域，流黄辛氏国/流黄酆氏国境内【地图推定】\n山地【原文直载】\n渑水发源地【原文直载】",
            "evidenceChain": "《山海经·海内经》，《山海经·海内西经》【原文直载】\n历代古注多认为《海内经》之“流黄辛氏”即《海内西经》之“流黄酆氏国”，“中有山”即明确指代巴遂山。两者实为同一地块在不同篇目中的记述。【古注补充】"
          },
