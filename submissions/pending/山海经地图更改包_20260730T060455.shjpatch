          "parserVariant": "mixed-heading-punctuation-v2",
          "sourceFile": "湖陵.md",
          "profile": {
            "regionPosition": "海内东部水系途经区域【地图推定】",
            "oneLineSummary": "湖陵是上古水网分布中的重要方位参照地，无专属神异特征，主要作为河道流经的地理坐标存在。【地图推定】",
            "briefSummary": "湖陵是上古水网分布中的重要方位参照地，无专属神异特征，主要作为河道流经的地理坐标存在。【地图推定】",
            "basicSummary": "海内东部水系途经区域【地图推定】",
            "localTags": "泗水流经【原文直载】、方位参照【地图推定】、过湖陵西【原文直载】、海内东侧【地图推定】、后世县邑【古注补充】",
            "tileType": "平原 / 水网【地图推定】",
            "hydrology": "泗水流经其西侧【原文直载】",
            "orientation": "海内东侧水系流域【地图推定】",
            "sourceCitation": "《山海经·海内东经》【原文直载】",
            "parentRegion": "海内东经【原文直载】",
            "adjacentTiles": "吴（在其东北）【原文直载】、淮阴（在其南）【原文直载】、东海（在其东南）【原文直载】",
            "relatedWaters": "泗水【原文直载】",
            "relatedLife": "原文未载【原文未载】",
            "tileOriginalExcerpt": "《海内东经》：“泗水出吴东北而南，西南过湖陵西，而东南注東海，入淮陰北。”【原文直载】",
            "otherAllusions": "据《汉书·地理志》等史籍载，汉代山阳郡设有湖陵县。历代古注及水经学者多借此段经文考证古代泗水流向、上古水道拓扑与地理沿革变迁。【古注补充】",
            "detailedSummary": "湖陵隶属于《山海经·海内东经》的地理版图，其核心属性是水系过境的方位锚点【地图推定】。根据原典记录，本地虽无特异的草木鸟兽或矿物神祇【原文未载】，但确是确立上古水网结构的关键坐标。泗水自吴地东北方发端向南，在西南方向穿越湖陵的西侧，最终向东南注入东海【原文直载】。由于其位于平原水网地带【地图推定】，与东海、淮阴等区域构成水路连线【原文直载】，湖陵在构建广阔的大世界地理沙盘或交互式虚拟地貌时，非常适合作为串联主干水系、引导视线流向的枢纽地块，是还原海内水文生态不可或缺的一环【地图推定】。",
            "geoEnvironment": "海内东部水系途经区域【地图推定】\n平原 / 水网【地图推定】\n泗水流经其西侧【原文直载】",
            "evidenceChain": "《山海经·海内东经》【原文直载】\n据《汉书·地理志》等史籍载，汉代山阳郡设有湖陵县。历代古注及水经学者多借此段经文考证古代泗水流向、上古水道拓扑与地理沿革变迁。【古注补充】"
          },
