        "dossier": {
          "format": "nine-section-v2",
          "parserVariant": "mixed-heading-punctuation-v2",
          "sourceFile": "辕厉.md",
          "profile": {
            "regionPosition": "海内东部区域，海中或沿海极远地带【地图推定】",
            "oneLineSummary": "辕厉是位于海内东部远海的上古地理坐标或方国，它是定位南方始鸠地块的核心基准节点。【地图推定】",
            "briefSummary": "辕厉是位于海内东部远海的上古地理坐标或方国，它是定位南方始鸠地块的核心基准节点。【地图推定】",
            "basicSummary": "海内东部区域，海中或沿海极远地带【地图推定】",
            "localTags": "在海中【地图推定】、始鸠之北【原文直载】、国名或鸟名【古注补充】、疑为韩雁讹误【古注补充】、海东极地【地图推定】",
            "tileType": "未载明确【原文未载】",
            "hydrology": "未载明确【原文未载】",
            "orientation": "海内东部，始鸠之北【原文直载】",
            "sourceCitation": "《山海经·海内东经》【原文直载】",
            "parentRegion": "海内东经【原文直载】",
            "adjacentTiles": "始鸠（在辕厉南）【原文直载】",
            "relatedWaters": "海【原文直载】",
            "relatedLife": "未载明确【原文未载】",
            "tileOriginalExcerpt": "《海内东经》：“始鸠在海中，辕厉南。”【原文直载】",
            "otherAllusions": "晋代郭璞注“始鸠……辕厉”曰：“国名，或曰鸟名也”。清代学者毕沅、郝懿行等考证认为，“辕厉”与前文“韩雁”字形相近，疑为传抄之讹误。然依原典独立成段，仍作独立地块留待考证。【古注补充】",
            "detailedSummary": "辕厉地处海内东部图卷的海中及沿海地带【地图推定】。在《山海经》极度简略的文字记载中，该地块唯一明确的地理功能是作为定位“始鸠”的北方基准坐标，即始鸠明确位于辕厉的南侧【原文直载】。原典中关于辕厉的山川地貌、水文特产、草木鸟兽以及神祇传说皆无任何细节着墨，呈现出上古东海未知的神秘感【原文未载】。晋代郭璞推测其可能为海中的古国名或飞鸟名，而清代学者则依据字形与上下文，高度怀疑“辕厉”实为前文“韩雁”一词的传抄讹误【古注补充】。在构建上古交互地图时，秉承原文优先的原则，辕厉可被视为东部海域中一处神秘的方国或岛屿节点。它与南方的始鸠互为空间依托，共同构成了《海内东经》深海区划的重要地理边界【地图推定】。",
            "geoEnvironment": "海内东部区域，海中或沿海极远地带【地图推定】\n未载明确【原文未载】",
            "evidenceChain": "《山海经·海内东经》【原文直载】\n晋代郭璞注“始鸠……辕厉”曰：“国名，或曰鸟名也”。清代学者毕沅、郝懿行等考证认为，“辕厉”与前文“韩雁”字形相近，疑为传抄之讹误。然依原典独立成段，仍作独立地块留待考证。【古注补充】"
          },
