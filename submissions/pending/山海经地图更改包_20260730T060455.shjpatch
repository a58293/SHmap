        "dossier": {
          "format": "nine-section-v2",
          "parserVariant": "mixed-heading-punctuation-v2",
          "sourceFile": "九嫔葬.md",
          "profile": {
            "regionPosition": "海外北经／海内东经境内山岳区域（即务隅之山／鲋鱼之山）",
            "oneLineSummary": "帝颛顼九嫔之墓葬所在区域，山体阴面环绕神话异兽与特殊灵物，兼具远古帝王陵寝神圣色彩与独特地理标志。",
            "briefSummary": "帝颛顼九嫔之墓葬所在区域，山体阴面环绕神话异兽与特殊灵物，兼具远古帝王陵寝神圣色彩与独特地理标志。",
            "basicSummary": "海外北经／海内东经境内山岳区域（即务隅之山／鲋鱼之山）",
            "localTags": "山海经 · 海外北经 · 海内东经 · 帝王陵寝 · 异兽栖息 · 阴阳分界 · 神话地理",
            "tileType": "山 / 阴坡",
            "hydrology": "原文未载明确（或关联汉水发源地，依具体经文而定）",
            "orientation": "海外北经、海内东经相关山岳阴面区域",
            "sourceCitation": "《山海经·海外北经》，《山海经·海内东经》",
            "parentRegion": "海外经 / 海内经",
            "adjacentTiles": "务隅之山（或鲋鱼之山主体）、平丘",
            "relatedWaters": "原文未载明确（海内东经附载汉水出焉）",
            "relatedLife": "熊、罴、文虎、离朱、𩿨久、视肉（海外北经异兽）；四蛇（海内东经载四蛇卫之）",
            "tileOriginalExcerpt": "《山海经·海外北经》：“务隅之山，帝颛顼葬于阳，九嫔葬于阴。一曰爰有熊、罴、文虎、离朱、𩿨久、视肉。”（控制在100字以内）",
            "otherAllusions": "后世《大荒北经》载“东北海之外……附禺之山，帝颛顼与九嫔葬焉”，诸多古籍如《太平御览》对颛顼及九嫔葬于务隅（鲋鱼）山阴阳两侧多有引述与地理考订。",
            "detailedSummary": "九嫔葬所在区域依托《山海经》原典记载，属于务隅之山（或鲋鱼之山）的神圣陵寝地块。其地貌以山岳阴坡为核心特征，是远古五帝之一颛顼之九嫔的归葬之所。原典记其阴面伴有熊、罴、文虎、离朱、𩿨久及视肉等异兽灵物，海内东经更载有四蛇护卫陵寝。此处兼具上古帝王陵墓的神秘色彩与荒古自然的地理风貌，是探究古代神话丧葬观念的重要原典坐标。",
            "geoEnvironment": "海外北经／海内东经境内山岳区域（即务隅之山／鲋鱼之山）\n山 / 阴坡\n原文未载明确（或关联汉水发源地，依具体经文而定）",
            "evidenceChain": "《山海经·海外北经》，《山海经·海内东经》\n后世《大荒北经》载“东北海之外……附禺之山，帝颛顼与九嫔葬焉”，诸多古籍如《太平御览》对颛顼及九嫔葬于务隅（鲋鱼）山阴阳两侧多有引述与地理考订。"
          },
