          "profile": {
            "regionPosition": "海外南部极远区域 / 白渊周边区域",
            "oneLineSummary": "此地为深渊白渊所在之所，是清白白水发源并滋养海外荒域神圣水系的关键源头地块。",
            "briefSummary": "此地为深渊白渊所在之所，是清白白水发源并滋养海外荒域神圣水系的关键源头地块。",
            "basicSummary": "海外南部极远区域 / 白渊周边区域",
            "localTags": "白渊、白水、海外荒域、水系源头、颛顼国、渊谷水泽",
            "tileType": "海外荒域 / 渊谷水泽",
            "hydrology": "白水源出白渊",
            "orientation": "海外南部区域",
