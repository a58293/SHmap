          ],
          "profile": {
            "regionPosition": "穷奇东侧与昆仑虚以北区域",
            "oneLineSummary": "位于穷奇之东、昆仑虚之北的未知生境，主要聚居着身披虎纹且小腿有肉的异人部落。",
            "briefSummary": "位于穷奇之东、昆仑虚之北的未知生境，主要聚居着身披虎纹且小腿有肉的异人部落。",
            "basicSummary": "穷奇东侧与昆仑虚以北区域",
            "localTags": "海内北经、昆仑虚北、穷奇之东、虎纹异人、胫有䏿、异国部落。",
            "tileType": "",
            "hydrology": "",
            "orientation": "在穷奇东 / 昆仑虚北所有",
            "sourceCitation": "《山海经·海内北经》",
            "parentRegion": "海内北经",
            "adjacentTiles": "穷奇活动区（西侧）、昆仑虚（南侧）",
            "relatedWaters": "",
            "relatedLife": "蟜、穷奇、蜪犬（参照方位定位）",
            "tileOriginalExcerpt": "“蟜，其为人虎文，胫有䏿。在穷奇东。一曰，状如人。昆仑虚北所有。”——出自《山海经·海内北经》",
            "otherAllusions": "《说文解字》中“蟜”为虫名；《大戴礼记》载帝喾之父名为“蟜极”。后世也有将“蟜”视为野人或远古国度之称，与《山海经》中的异人部落或有渊源，但原典仅作客观外貌描述。",
            "detailedSummary": "在《山海经·海内北经》的记载中，蟜地位于穷奇活动区的东侧，同时属于昆仑虚以北的生态模块。原典中对该地块的地貌、水系、草木及矿物等环境细节均未载明确，是一处充满未知的原始地带。此地唯一且核心的特征，是生活着名为“蟜”的群体。他们虽为人形，但周身长满凶兽般的虎纹，且小腿上长有明显的肉块（胫有䏿）；另有异闻称其外貌与常人无异。蟜地虽无明确的环境描绘，但其西接食人凶兽穷奇的领地，南靠神山昆仑虚，使得该区域处于凶险异兽与神明圣境的交界带，展现了海内北部异人部落与神话异兽共存的独特生态格局。",
            "geoEnvironment": "穷奇东侧与昆仑虚以北区域\n未载（原文未载明确）",
            "evidenceChain": "《山海经·海内北经》\n《说文解字》中“蟜”为虫名；《大戴礼记》载帝喾之父名为“蟜极”。后世也有将“蟜”视为野人或远古国度之称，与《山海经》中的异人部落或有渊源，但原典仅作客观外貌描述。"
          },
          "museumEntries": [
            {
              "sourceCategory": "人群神祇",
              "name": "蟜（异人/部落）",
              "localRelation": "居于此地",
              "coreFeatures": "人身虎纹，胫有䏿",
              "evidence": "出自《山海经·海内北经》",
              "efficacy": "",
