            "regionPosition": "大荒南部山地区域（原文直载）",
            "oneLineSummary": "位于大荒南部群山之中，是黑水流经大荒后最终断流枯竭的尾闾之山。",
            "briefSummary": "位于大荒南部群山之中，是黑水流经大荒后最终断流枯竭的尾闾之山。",
            "basicSummary": "大荒南部山地区域（原文直载）",
            "localTags": "大荒南部、不姜之山、黑水穷焉、独立地块、黑水尾闾、水源终点",
            "tileType": "山",
            "hydrology": "黑水尾闾（黑水穷焉，为水流终结断流处）",
            "orientation": "大荒之中（南部区域）",
            "sourceCitation": "《山海经·大荒南经》",
            "parentRegion": "大荒南经",
