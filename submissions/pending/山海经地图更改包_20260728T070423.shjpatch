        "dossier": {
          "format": "nine-section-v2",
          "sourceFile": "169__任务六__从渊.md",
          "sourceFiles": [
            "169__任务六__从渊.md"
          ],
          "profile": {
            "regionPosition": "大荒南部水系区域（原文直载）",
            "oneLineSummary": "位于大荒南部四方渊南侧的附属深水潭，是上古帝王帝舜曾经在此沐浴的神圣水文遗迹所在地。",
            "briefSummary": "位于大荒南部四方渊南侧的附属深水潭，是上古帝王帝舜曾经在此沐浴的神圣水文遗迹所在地。",
            "basicSummary": "大荒南部水系区域（原文直载）",
            "localTags": "大荒之中、从渊、渊四方南旁、舜浴遗迹、帝王遗踪、附属水域",
            "tileType": "渊 / 水域",
            "hydrology": "原文未载发源（依附于四方渊南侧）",
            "orientation": "大荒之中（南部区域四方渊南侧）",
            "sourceCitation": "《山海经·大荒南经》",
            "parentRegion": "大荒南经",
            "adjacentTiles": "渊四方（北侧）、少和之渊（同属四方渊旁，地图推定）",
            "relatedWaters": "从渊、四方渊",
            "relatedLife": "",
            "tileOriginalExcerpt": "“有渊四方，四隅皆达……北旁名曰少和之渊，南旁名曰从渊，舜之所浴也。”出自《山海经·大荒南经》。",
            "otherAllusions": "晋代郭璞注“从渊”云：“从音纵”，原文主要为正音之用（古注补充）。后世考证多聚焦于“舜之所浴也”这一记录，认为此举强化了该水域在帝王南巡传说中的坐标地位，反映了先民对舜帝南方活动轨迹的地理认定。",
            "detailedSummary": "结合《山海经·大荒南经》原典记载，从渊是大荒南部一处具有极高人文神话价值的附属水域地块。在地理坐标上，它被明确界定于四通八达的水文枢纽“渊四方”的南部边缘（原文直载“南旁”）。作为一处深水渊潭，从渊与北侧的少和之渊遥相呼应，共同构筑了南部大荒交错纵横的深渊水网。该地块虽然没有记录珍奇草木、飞禽走兽或金玉矿藏，但却因“舜之所浴也”这一核心事件而拥有极高的辨识度。上古帝王帝舜曾涉足此地并在此沐浴，使得从渊不再仅仅是一个纯粹的自然水文节点，而是化身为承载上古帝王南巡踪迹的神圣遗迹，真实反映了先民对南方荒野水系与帝王神话融合的地理认知。",
            "geoEnvironment": "大荒南部水系区域（原文直载）\n渊 / 水域\n原文未载发源（依附于四方渊南侧）",
            "evidenceChain": "《山海经·大荒南经》\n晋代郭璞注“从渊”云：“从音纵”，原文主要为正音之用（古注补充）。后世考证多聚焦于“舜之所浴也”这一记录，认为此举强化了该水域在帝王南巡传说中的坐标地位，反映了先民对舜帝南方活动轨迹的地理认定。"
          },
