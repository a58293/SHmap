          "profile": {
            "regionPosition": "海内东部沿海交汇区域 [地图推定]",
            "oneLineSummary": "潦阳是海内东部的重要地标，承接自西北而来的大川潦水在此处最终汇入广阔无垠的渤海之中。",
            "briefSummary": "潦阳是海内东部的重要地标，承接自西北而来的大川潦水在此处最终汇入广阔无垠的渤海之中。",
            "basicSummary": "海内东部沿海交汇区域 [地图推定]",
            "localTags": "潦水入注、渤海之滨、潦阳地标、海内东部、江河归海",
            "tileType": "平原 / 沿海 / 城邑 [地图推定/古注补充]",
            "hydrology": "潦水自此入海点 [原文直载]",
            "orientation": "海内东部区域 [古注补充]",
            "sourceCitation": "《山海经·海内东经》",
            "parentRegion": "海内东经总域 [地图推定]",
            "adjacentTiles": "渤海 [原文直载]",
            "relatedWaters": "潦水、渤海 [原文直载]",
            "relatedLife": "",
            "tileOriginalExcerpt": "“潦水出卫皋东，东南注渤海，入潦阳。”（出自《山海经·海内东经》）",
            "otherAllusions": "晋·郭璞《山海经注》：“潦阳，县名也，在辽东。”（指出了晋代认知中潦阳的地貌属性为沿海城邑，并给出了位于辽东的方位参考。）",
            "detailedSummary": "潦阳隶属于《海内东经》记载的海内东部区域，是一处与海洋紧密相连的枢纽地标。根据原典直载，发源于卫皋东侧的浩荡“潦水”一路向东南方向奔腾，最终在“潦阳”这个关键节点尽数汇入广袤的“渤海”之中。晋代郭璞在注疏中将其解释为辽东地带的县邑，赋予了它城邑的人文属性。虽然《山海经》原文未明确记载潦阳周边的奇珍异兽、神祇或具体坐标方位，但仅凭“入潦阳”三字的明确关联，便精准定格了内陆大川与汪洋交汇的壮阔地理终局。在地图世界观构建中，潦阳非常适合作为连接内陆水网与海洋区域探索的沿岸港口城镇与入海坐标。",
            "geoEnvironment": "海内东部沿海交汇区域 [地图推定]\n平原 / 沿海 / 城邑 [地图推定/古注补充]\n潦水自此入海点 [原文直载]",
            "evidenceChain": "《山海经·海内东经》\n晋·郭璞《山海经注》：“潦阳，县名也，在辽东。”（指出了晋代认知中潦阳的地貌属性为沿海城邑，并给出了位于辽东的方位参考。）"
          },
