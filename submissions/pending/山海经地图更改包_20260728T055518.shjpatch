          ],
          "profile": {
            "regionPosition": "海内东部山地区域（《海内东经》区域）",
            "oneLineSummary": "海内东部的一座重要山脉，作为知名水系的起源参照地，孕育的河水自其东侧发源，并一路向东南奔流汇入大河。",
            "briefSummary": "海内东部的一座重要山脉，作为知名水系的起源参照地，孕育的河水自其东侧发源，并一路向东南奔流汇入大河。",
            "basicSummary": "海内东部山地区域（《海内东经》区域）",
            "localTags": "海内东经、山岳地貌、沁水起点、井陉山东、水系源头参照",
            "tileType": "",
            "hydrology": "沁水发源于其东侧（原文直载）",
            "orientation": "海内东部区域",
            "sourceCitation": "《山海经·海内东经》",
            "parentRegion": "海内东经",
            "adjacentTiles": "怀（水系流经定位关联）",
            "relatedWaters": "沁水、河（黄河）",
            "relatedLife": "",
            "tileOriginalExcerpt": "“沁水出井陉山东，东南注河，入怀东南。”\n\n——出自《山海经·海内东经》",
            "otherAllusions": "郭璞注：“井陉，山名，在中山。怀，河内怀县。”（注：此为晋代古注补充，指出汉晋时期对应的地理位置与行政建制，仅作古注考据参考，不得覆盖原典本身的空间坐标）。",
            "detailedSummary": "井陉山是《山海经·海内东经》中记载的海内东部一处重要山岳地貌。在原典的地理坐标体系中，井陉山最核心的意义在于它是重要河流“沁水”的发源地参照锚点（原文直载）。沁水正是从井陉山的东侧（井陉山东）发源而出，随后水势一路向东南方向蜿蜒流淌，最终在怀地之东南汇入庞大的大河（河）之中。这段记载十分凝练，将井陉山作为确立“井陉山—沁水—河—怀”水文地理动线的源头地标。至于井陉山本体的具体山势样貌、山中所生长的奇花异草、栖息的飞禽走兽，或是蕴藏的矿产与神仙异事，原文中均无任何延伸描述（原文未载），属于原典地理拼图中一处留白的待考区域。",
            "geoEnvironment": "海内东部山地区域（《海内东经》区域）\n山地\n沁水发源于其东侧（原文直载）",
            "evidenceChain": "《山海经·海内东经》\n郭璞注：“井陉，山名，在中山。怀，河内怀县。”（注：此为晋代古注补充，指出汉晋时期对应的地理位置与行政建制，仅作古注考据参考，不得覆盖原典本身的空间坐标）。"
          },
